{
  "name": "@office-sim/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm build:server && node server-bundle.mjs",
    "dev:ui": "vite",
    "build": "vite build && pnpm build:server",

    "build:server": "esbuild src/server/index.ts --bundle --platform=node --format=esm --outfile=server-bundle.mjs --packages=bundle",
    "preview": "vite preview",
    "start": "node server-bundle.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@office-sim/agents": "workspace:*",
    "@office-sim/game": "workspace:*",
    "@office-sim/shared": "workspace:*",
    "@office-sim/sim": "workspace:*",
    "@office-sim/ui": "workspace:*",
    "phaser": "^3.87.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.3",
    "vite": "^6.4.5"
  }
}

